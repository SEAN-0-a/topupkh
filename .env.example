# Copy this file to `.env.local` and fill in YOUR values.
# NEVER commit `.env.local` or put real secrets in source control.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-publishable-anon-key

# --- Telegram escrow notification bot (the "manual verification pilot" gofer) ---
# When you deploy pay verification properly with Bakong/ABA webhooks these two
# should be DELETED and the bot dropped in favor of signed webhooks.
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=YOUR-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_CHAT_ID=YOUR-telegram-chat-id

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Turnstile (login bot protection) ---
# Widget key (safe to expose to the client).
# https://dashboard.cloudflare.com/ -> Turnstile -> your widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR-turnstile-site-key
# Server-only secret used by /api/auth to verify tokens with siteverify.
# Must belong to the SAME widget as the site key above (the "1x" keys are
# Cloudflare's test keys and only pair with each other).
TURNSTILE_SECRET_KEY=YOUR-turnstile-secret-key

# --- ABA PayWay checkout (from the ABA merchant portal) ---
# Sandbox purchase endpoint (swap to checkout.payway.com.kh (no sandbox.) for prod).
ABA_PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_PAYWAY_MERCHANT_ID=YOUR-merchant-id
ABA_PAYWAY_API_KEY=YOUR-hmac-api-key

# --- Supabase SERVICE-ROLE key (server-only, BYPASSES RLS) ---
# Used only by trusted background jobs (e.g. the ABA webhook handler). NEVER
# prefix this one with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-secret-key
