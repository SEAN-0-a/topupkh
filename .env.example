# Copy this file to `.env.local` and fill in YOUR values.
# NEVER commit `.env.local` or put real secrets in source control.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-publishable-anon-key

# --- Telegram escrow notification bot (the "manual verification pilot" gofer) ---
# When you deploy pay verification properly with Bakong/ABA webhooks these two
# should be DELETED and the bot dropped in favor of signed webhooks.
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=YOUR-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_CHAT_ID=YOUR-telegram-chat-id

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
